literal frozen?              -> false
after <<                     -> "hello there"
after freeze                 -> true
mutating a frozen String     -> FrozenError: can't modify frozen String: "hello"

(+frozen).frozen?            -> false
(-greeting).frozen?          -> true
-str deduplicates            -> true
+str is a new object         -> false

default arg, call 1          -> ["ruby", "new"]
default arg, call 2          -> ["ruby", "new"]
constant, call 1             -> ["ruby", "new"]
constant, call 2             -> ["ruby", "new", "new"]
constant now holds           -> ["ruby", "new", "new"]

frozen constant              -> FrozenError: can't modify frozen Array: ["ruby"]
NESTED.frozen?               -> true
NESTED[0].frozen?            -> false
inner mutated anyway         -> ["ruby!"]
