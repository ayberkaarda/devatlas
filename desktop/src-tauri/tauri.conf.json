{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DevAtlas",
  "version": "0.1.0",
  "identifier": "dev.devatlas.desktop",
  "build": {
    "frontendDist": "../../frontend/dist/tauri/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm --prefix ../frontend run start",
    "beforeBuildCommand": "npm --prefix ../frontend run build:tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DevAtlas",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
