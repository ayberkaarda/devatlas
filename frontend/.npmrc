# Turn the engines field in package.json into a hard error instead of a warning.
#
# Node 22 ships npm 10 and Node 26 ships npm 11, and a lockfile written by one
# major is rejected by the other with "Missing: ... from lock file". The version
# cannot be recovered from the lockfile itself — both majors write
# lockfileVersion 3 — so the mismatch only surfaces later, on someone else's
# machine or in CI. Failing the install is the earliest place to catch it.
engine-strict=true
